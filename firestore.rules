rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "noriodeobaro@gmail.com" && request.auth.token.email_verified == true;
    }
    // Each man writes only his own profile and logs; everyone signed in can read (crews + coach).
    match /people/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Proof photos feed the crew wall, so any member can see them.
      match /proofs/{pid} {
        allow read: if signedIn();
        allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
      // Daily logs, plans and coach notes: only the man himself and the coach.
      match /{sub}/{doc} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }
    function inCrew(gid) {
      return gid in get(/databases/$(database)/documents/people/$(request.auth.uid)).data.get('groups', []);
    }
    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.by == request.auth.uid || isAdmin());
      // Each crew's prayer wall: only that crew's members (and the coach) read and post.
      match /posts/{pid} {
        allow read: if signedIn() && (isAdmin() || inCrew(gid));
        allow create: if signedIn() && request.resource.data.by == request.auth.uid && (isAdmin() || inCrew(gid))
          && request.resource.data.text is string && request.resource.data.text.size() <= 600;
        // Members can tap Praying/Amen (only the amen list may change); authors and the coach can edit or delete.
        allow update: if signedIn() && (resource.data.by == request.auth.uid || isAdmin()
          || (inCrew(gid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amen'])));
        allow delete: if signedIn() && (resource.data.by == request.auth.uid || isAdmin());
      }
    }
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
